{
  "name": "motomoto-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @motomoto/web dev",
    "dev:extension": "pnpm --filter @motomoto/extension dev",
    "build": "pnpm build:extension && pnpm build:web",
    "build:web": "pnpm --filter @motomoto/web build",
    "build:extension": "pnpm --filter @motomoto/extension build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --configLoader runner --config tooling/vitest.config.ts",
    "test:watch": "vitest --configLoader runner --config tooling/vitest.config.ts",
    "migrate:data": "node --experimental-strip-types scripts/migrate-existing-dataset.ts",
    "validate:data": "node --experimental-strip-types scripts/validate-seed-data.ts",
    "clean:submission": "powershell -ExecutionPolicy Bypass -File scripts/package-submission.ps1"
  },
  "devDependencies": {
    "@motomoto/domain": "workspace:*",
    "@motomoto/data-access": "workspace:*",
    "@motomoto/extraction": "workspace:*",
    "@motomoto/valuation": "workspace:*",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "csv-parse": "^6.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

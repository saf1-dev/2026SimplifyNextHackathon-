# Server-only. Never expose this value to the extension or browser bundle.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# local-json for development, dynamodb for AWS.
MOTOMOTO_REPOSITORY=local-json
MOTOMOTO_LOCAL_DATA_PATH=.runtime/motomoto-local.json
MOTOMOTO_TABLE_NAME=motomoto-poc
AWS_REGION=us-east-1

# Comma-separated exact origins. CORS is not authentication.
ALLOWED_WEB_ORIGINS=http://localhost:3000
ALLOWED_EXTENSION_ORIGINS=

VALUATION_VERSION=motomoto-comparable-v2
LOG_LEVEL=info
MOTOMOTO_SOURCE_BUCKET=
